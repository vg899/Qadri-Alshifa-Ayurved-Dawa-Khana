rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product Images: Publicly readable by all visitors
    // Uploads/Deletes restricted to authenticated store administrators
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@qadrialshifa[.]com$')
      );
    }
  }
}
