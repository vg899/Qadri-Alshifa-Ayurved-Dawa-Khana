rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is an authorized admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@qadrialshifa[.]com$')
      );
    }

    // Products Collection
    // Public read: Anyone can browse classical Ayurvedic formulations
    // Write: Only authenticated admins can add, update or delete products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories Collection
    // Public read: Anyone can view categories
    // Write: Only admins can manage categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders & Inquiries Collection
    // Create: Anyone (customers submitting order inquiries) can create an order record
    // Read & Update: Only authenticated admins can read order lists and update dispatch statuses
    match /orders/{orderId} {
      allow create: if request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount >= 0;
      allow read, update, delete: if isAdmin();
    }
  }
}
